{
    "name": "iwtc-frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "env-cmd -f .env.development next dev",
        "prod": "env-cmd -f .env.production next dev",
        "build:prod": "env-cmd -f .env.production next build",
        "build": "env-cmd -f .env.production next build",
        "start": "next start -p 8080",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "test": "tsc -p tsconfig.test.json && node --test .test-dist/utils/*.test.js .test-dist/domain/game/*.test.js .test-dist/domain/home/*.test.js .test-dist/domain/manage/*.test.js .test-dist/services/*.test.js .test-dist/interfaces/models/world-cup/*.test.js .test-dist/lib/react-query/*.test.js"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.3.1",
        "@react-spring/web": "^9.7.3",
        "@tanstack/react-query": "^4.36.1",
        "@tanstack/react-query-devtools": "^4.36.1",
        "@types/shortid": "^0.0.32",
        "axios": "^1.5.1",
        "env-cmd": "^10.1.0",
        "moment": "^2.29.4",
        "next": "13.5.4",
        "react": "^18",
        "react-cookie": "^6.1.1",
        "react-dom": "^18",
        "react-hook-form": "^7.47.0",
        "react-infinite-scroller": "^1.2.6",
        "react-youtube": "^10.1.0",
        "sharp": "^0.33.2",
        "shortid": "^2.2.16",
        "tw-elements-react": "^1.0.0-alpha1",
        "yup": "^1.3.2"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@types/react-infinite-scroller": "^1.2.4",
        "autoprefixer": "^10",
        "eslint": "^8",
        "eslint-config-next": "13.5.4",
        "postcss": "^8",
        "tailwindcss": "^3",
        "typescript": "^5"
    }
}
