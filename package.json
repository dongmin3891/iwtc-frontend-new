{
    "name": "iwtc-frontend",
    "version": "2.0.0",
    "private": true,
    "scripts": {
        "dev": "env-cmd -f .env.development next dev",
        "prod": "env-cmd -f .env.production next dev",
        "build:prod": "env-cmd -f .env.production next build",
        "build": "env-cmd -f .env.production next build",
        "start": "next start -p 8080",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "tsc -p tsconfig.test.json && node --test .test-dist/utils/*.test.js .test-dist/domain/game/*.test.js .test-dist/domain/home/*.test.js .test-dist/domain/manage/*.test.js .test-dist/domain/updates/*.test.js .test-dist/services/*.test.js .test-dist/interfaces/models/world-cup/*.test.js .test-dist/lib/react-query/*.test.js .test-dist/features/traffic/*.test.js"
    },
    "dependencies": {
        "@hookform/resolvers": "^3.3.1",
        "@react-spring/web": "^9.7.3",
        "@tanstack/react-query": "^4.36.1",
        "@tanstack/react-query-devtools": "^4.36.1",
        "axios": "^1.21.1",
        "env-cmd": "^10.1.0",
        "moment": "^2.31.0",
        "next": "16.4.6",
        "react": "^18",
        "react-dom": "^18",
        "react-hook-form": "^7.47.0",
        "react-infinite-scroller": "^1.2.6",
        "react-youtube": "^10.1.0",
        "sharp": "^0.35.5",
        "yup": "^1.3.2"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@types/react-infinite-scroller": "^1.2.4",
        "autoprefixer": "^10",
        "eslint": "^9.39.1",
        "eslint-config-next": "16.4.6",
        "postcss": "^8.5.32",
        "tailwindcss": "^3",
        "typescript": "^5"
    }
}
